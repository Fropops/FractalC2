@implements IDisposable
@using System.Collections.Generic
@using Common.AgentCommands
@using Common.CommandLine.Execution
@using Common.Models
@using Shared
@using Shared.ResultObjects
@using System.Reflection
@using WebCommander.Commands
@using WebCommander.Components
@using WebCommander.Helpers
@using WebCommander.Models
@using WebCommander.Services
@inject AgentService AgentService
@inject NavigationManager NavigationManager
@inject CommandService CommandService
@inject IJSRuntime JSRuntime
@inject TerminalHistoryService TerminalHistoryService
@inject TaskResultFormatterService FormatterService
@inject TerminalCompletionService CompletionService
@inject AgentSessionService SessionService

<div class="agent-terminal-session">
	@if (agent == null)
	{
		<div class="alert alert-warning m-3">
			<i class="bi bi-exclamation-triangle me-2"></i> Agent (@AgentId) introuvable ou déconnecté.
		</div>
	}
	else
	{
		<div class="terminal-container">
			<TerminalOutput @ref="terminalOutputComponent"
							Lines="@outputLines"
							OnDownloadFile="DownloadFile"
							OnDeleteFile="DeleteFile"
							OnDeleteDirectory="DeleteDirectory"
							OnListDirectory="ListDirectory"
							OnEnterDirectory="EnterDirectory"
							OnMigrateProcess="MigrateProcess"
							OnKillJob="KillJob"
							OnUnlinkAgent="UnlinkAgent"
							AgentOsType="@(agent?.Metadata?.OsType ?? OsType.Windows)" />

			<div class="terminal-input-container">
				<span class="terminal-prompt">@(agent.Metadata?.Name ?? "Unknown") &gt;</span>
				<input type="text"
					   class="terminal-input"
					   @bind="currentCommand"
					   @bind:event="oninput"
					   @onkeydown="HandleKeyDown"
					   @ref="inputElement"
					   placeholder="Type a command (Tab for completion)..." />
			</div>
		</div>
	}
</div>

<FileUploadModal @ref="fileUploadModal" />

<style>
	.agent-terminal-session {
		height: 100%;
		display: flex;
		flex-direction: column;
		min-height: 0;
		flex: 1;
	}

	.agent-terminal-session .terminal-container {
		flex: 1;
		display: flex;
		flex-direction: column;
		background-color: #1e1e1e;
		color: #d4d4d4;
		font-family: 'Consolas', 'Courier New', monospace;
		margin: 0;
		border-radius: 6px;
		overflow: hidden;
		min-height: 0;
		height: calc(100vh - 215px);
		min-width: 0;
		border: 1px solid #2d2d30;
	}

	.agent-terminal-session .terminal-output {
		flex: 1;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 16px;
		font-size: 14px;
		line-height: 1.5;
		min-height: 0;
	}

	.agent-terminal-session .terminal-line {
		margin-bottom: 4px;
		white-space: pre-wrap;
		word-wrap: break-word;
		word-break: break-all;
		overflow-wrap: anywhere;
	}

	.agent-terminal-session .terminal-line.error {
		color: #f48771;
	}

	.agent-terminal-session .terminal-line.warning {
		color: #dcdcaa;
	}

	.agent-terminal-session .terminal-line.info {
		color: #4ec9b0;
	}

	.agent-terminal-session .terminal-line.success {
		color: #98c379;
	}

	.agent-terminal-session .terminal-line.normal {
		color: #d4d4d4;
	}

	.agent-terminal-session .terminal-line.command {
		color: #569cd6;
	}

	.agent-terminal-session .terminal-input-container {
		background-color: #252526;
		padding: 10px 16px;
		border-top: 1px solid #333337;
		display: flex;
		align-items: center;
	}

	.agent-terminal-session .terminal-prompt {
		color: #4ec9b0;
		margin-right: 10px;
		font-weight: bold;
		white-space: nowrap;
	}

	.agent-terminal-session .terminal-input {
		flex: 1;
		background-color: transparent;
		border: none;
		color: #d4d4d4;
		font-family: inherit;
		font-size: 14px;
		outline: none;
		padding: 0;
	}

	.agent-terminal-session .terminal-input::placeholder {
		color: #6a737d;
	}

	.agent-terminal-session .terminal-output::-webkit-scrollbar {
		width: 10px;
	}

	.agent-terminal-session .terminal-output::-webkit-scrollbar-track {
		background: #1e1e1e;
	}

	.agent-terminal-session .terminal-output::-webkit-scrollbar-thumb {
