@page "/agent-tasks/{AgentId}"
@using WebCommander.Services
@inject AgentSessionService SessionService
@inject NavigationManager NavigationManager

<div class="p-3 text-muted">
    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
    Opening agent session tasks...
</div>

@code {
    [Parameter]
    public string AgentId { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        SessionService.OpenSession(AgentId, "tasks");
        NavigationManager.NavigateTo($"/sessions/{AgentId}?view=tasks", replace: true);
    }
}
